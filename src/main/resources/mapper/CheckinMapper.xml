<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.airport_kiosk.checkin.mapper.CheckinMapper">

    <select id="countByPnr" resultType="int">
        SELECT COUNT(*)
        FROM CHECKIN
        WHERE pnr = #{pnr}
    </select>

</mapper>
